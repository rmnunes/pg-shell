{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pg-shell",
  "version": "0.4.0",
  "identifier": "dev.pgshell.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pg-shell",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rmnunes/pg-shell/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MzY5NjIzRDQ1Q0ZCRUQKUldUdCsxelVJNVkyMlJoZXlaKzVOcXVVd3VLYmp0RlVMMVYzTEZmcG51ZzE2U2k1b09tblJ1SUYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
