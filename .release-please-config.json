{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "draft": false,
  "prerelease": false,
  "plugins": ["cargo-workspace"],
  "packages": {
    "src-tauri": {
      "release-type": "rust",
      "package-name": "pg-shell",
      "changelog-path": "../CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "../package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "tauri.conf.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "crates/pg-core": {
      "release-type": "rust",
      "package-name": "pg-core",
      "skip-github-release": true
    },
    "crates/pg-intellisense": {
      "release-type": "rust",
      "package-name": "pg-intellisense",
      "skip-github-release": true
    },
    "crates/pg-schema-cache": {
      "release-type": "rust",
      "package-name": "pg-schema-cache",
      "skip-github-release": true
    },
    "crates/pg-profiles": {
      "release-type": "rust",
      "package-name": "pg-profiles",
      "skip-github-release": true
    }
  }
}
